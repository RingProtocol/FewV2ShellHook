# Copy to .env and fill in. Forge loads .env from the repository root automatically;
# variables already exported in the shell take precedence. Never commit .env.
# Shell commands that read these values need them exported: set -a; source .env; set +a
# Keep signing keys in Foundry keystores or hardware wallets, not in this file.

# ---------- Network ----------
ETH_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/<key>"
ETHERSCAN_API_KEY=

# ---------- Roles: constructor inputs, part of the CREATE2 init code ----------
# Changing any value below changes the Hook address and requires re-mining.
POOL_INITIALIZER_ADDRESS=
RESIDUAL_RECIPIENT_ADDRESS=
# Address of the SubsidyVault that holds the shared protocol-fee subsidy budget.
# The vault must exist before the Hook is deployed; its owner arms it with
# `setHook(hook)` afterwards, and that call is permanent.
SUBSIDY_VAULT_ADDRESS=
HOOK_OWNER_ADDRESS=
GUARDIAN_ADDRESS=
# ADD_TIMELOCK_DELAY=172800

# ---------- Dependency overrides (Ethereum mainnet defaults are built in) ----------
# V4_POOL_MANAGER=0x000000000004444c5dc75cB358380D2e3dE08A90
# WETH=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
# V4_QUOTER=0x52F0E24D1c21C8A0cB1e5a5dD6198556BD9E1203
# FEW_FACTORY=0x7D86394139bf1122E82FDF45Bb4e3b038A4464DD
# FEW_V2_FACTORY=0xeb2A625B704d73e82946D8d026E1F588Eed06416

# ---------- Mining output: uncomment after running MineHookAddress ----------
# NATIVE_ETH_HOOK_SALT=0x
# NATIVE_ETH_EXPECTED_HOOK_ADDRESS=0x
# WETH_HOOK_SALT=0x
# WETH_EXPECTED_HOOK_ADDRESS=0x

# ---------- After deployment ----------
# HOOK_ADDRESS=0x
# HOOK_SALT=0x
# EXPECT_NATIVE_ETH=true
